{
  "name": "ess-node-sdk",
  "version": "1.0.0",
  "description": "eSSL/ZKTeco Device Communication SDK - Complete server wrapper",
  "main": "dist/index.js",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "start": "node dist/test.js",
    "build": "tsc",
    "dev": "nodemon --exec \"tsc && node dist/test.js\" --watch lib --watch index.ts --watch test.ts --ext ts",
    "dev:ts": "nodemon --exec ts-node test.ts --watch lib --watch index.ts --watch test.ts --ext ts",
    "watch": "tsc --watch"
  },
  "keywords": [
    "essl",
    "zkteco",
    "biometric",
    "attendance",
    "device",
    "sdk",
    "user-management",
    "server"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-xml-bodyparser": "^0.4.1",
    "node-zklib": "^1.3.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/xml2js": "^0.4.14",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
